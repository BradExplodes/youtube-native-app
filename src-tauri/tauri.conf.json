{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Music Native",
  "version": "../package.json",
  "identifier": "com.ytmnative.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "YouTube Music Native",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600,
        "backgroundColor": "#0a0a0d",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.ytimg.com https://*.googleusercontent.com https://*.ggpht.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://lrclib.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0MTU1REExQjNBREQzNTMKUldSVDA2MnpvVjBWQkh5MlFBRk5NRk5HWk9TTXMwME1WOVNPZVQ0QWIyeW1XdjNwclkvQXNyblkK",
      "endpoints": ["https://github.com/BradExplodes/youtube-native-app/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
